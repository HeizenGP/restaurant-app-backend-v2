# Copy this file to .env. The sample password is for local development only.
COMPOSE_PROJECT_NAME=restaurant-app-v2
POSTGRES_DB=restaurant_app
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_PORT=5432

RESTAURANT_APP_NAME=Restaurant App V2 API
RESTAURANT_APP_VERSION=0.1.0
RESTAURANT_ENVIRONMENT=local
RESTAURANT_DEBUG=false
RESTAURANT_LOG_LEVEL=INFO
RESTAURANT_API_V1_PREFIX=/api/v1
RESTAURANT_DATABASE_URL=postgresql+asyncpg://restaurant_app:replace-this-local-password@127.0.0.1:5432/restaurant_app
RESTAURANT_DATABASE_ECHO=false
RESTAURANT_DATABASE_POOL_SIZE=5
RESTAURANT_DATABASE_MAX_OVERFLOW=10
RESTAURANT_DATABASE_POOL_TIMEOUT_SECONDS=30
RESTAURANT_DATABASE_POOL_RECYCLE_SECONDS=1800
RESTAURANT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
